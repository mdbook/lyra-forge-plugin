<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- lyra-forge-plugin checkstyle: Forge's two import checks plus a few cheap hygiene rules. -->
<module name="Checker">
    <!-- generated from javap output: its fully qualified types exceed LineLength -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="DelegationCounter\.java$"/>
    </module>
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>
    <module name="LineLength">
        <property name="max" value="140"/>
    </module>
    <module name="TreeWalker">
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="IllegalImport">
            <!-- no forge-gui: the plugin builds against forge-core, forge-game and forge-ai only -->
            <property name="illegalPkgs" value="forge.gui, forge.model, forge.localinstance, forge.player, forge.gamemodes"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored"/>
        </module>
        <module name="EqualsHashCode"/>
    </module>
</module>
